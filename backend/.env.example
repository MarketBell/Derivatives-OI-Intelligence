# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE (MongoDB)
# ==========================================
# e.g., mongodb+srv://<user>:<password>@<cluster>.mongodb.net/oi_intelligence?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
# Must be a long, random, secure string in production
JWT_SECRET=your_jwt_secret_here

# ==========================================
# BROKER CONFIGURATION (Upstox / Dhan)
# ==========================================
# Note: You only need to provide valid tokens for the active broker.
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here
DHAN_CLIENT_ID=your_dhan_client_id_here
# DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# ==========================================
# ADMIN PORTAL CONFIGURATION
# ==========================================
# Email to create the default admin user on first startup
ADMIN_EMAIL=admin@yourdomain.com
# Initial password for the default admin user
ADMIN_INITIAL_PASSWORD=secure_initial_password

# ==========================================
# CORS (Cross-Origin Resource Sharing)
# ==========================================
# In production, set this to your exact frontend domain (e.g., https://oi.billionitwealth.in)
# In development, use http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
